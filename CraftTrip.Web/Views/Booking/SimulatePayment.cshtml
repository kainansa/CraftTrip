@model CraftTrip.Core.Entities.Booking
@{
    ViewData["Title"] = "VNPay Sandbox Simulator";
}

<div class="container py-5">
    <div class="max-w-600 mx-auto">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center">
            <div class="d-inline-flex p-3 bg-primary bg-opacity-10 text-primary rounded-circle mb-3 mx-auto">
                <i class="bi bi-credit-card-2-front fs-1"></i>
            </div>
            <span class="badge bg-primary-subtle text-primary fw-bold mb-2">VNPAY SANDBOX TEST GATEWAY</span>
            <h3 class="font-serif fw-bold mb-2">Cổng mô phỏng thanh toán</h3>
            <p class="text-muted small mb-4">Môi trường phát triển và kiểm thử giao dịch không cần thẻ ngân hàng thật.</p>

            <div class="bg-light rounded-3 p-4 mb-4 text-start small">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Mã đơn đặt chỗ:</span>
                    <strong class="font-monospace text-dark">@Model.BookingCode</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Workshop:</span>
                    <strong class="text-dark">@Model.Workshop?.Title</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Số lượng khách:</span>
                    <strong class="text-dark">@Model.Quantity người</strong>
                </div>
                <div class="d-flex justify-content-between pt-2 border-top">
                    <span class="fw-bold text-dark">Số tiền cần thanh toán:</span>
                    <span class="price-tag fs-5">@Model.TotalAmount.ToString("N0") đ</span>
                </div>
            </div>

            <div class="d-flex flex-column gap-2 mb-3">
                <form asp-action="CompleteSimulatedPayment" method="post" class="w-100">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingCode" value="@Model.BookingCode" />
                    <button type="submit" class="btn btn-success w-100 py-3 fw-bold fs-6 shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Xác nhận thanh toán thành công (Mô phỏng VNPay)
                    </button>
                </form>

                <div class="row g-2">
                    <div class="col-sm-6">
                        <form asp-action="FailSimulatedPayment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingCode" value="@Model.BookingCode" />
                            <button type="submit" class="btn btn-outline-danger w-100 py-2 small fw-semibold">
                                <i class="bi bi-x-circle me-1"></i> Mô phỏng lỗi giao dịch
                            </button>
                        </form>
                    </div>
                    <div class="col-sm-6">
                        <form asp-action="CancelSimulatedPayment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingCode" value="@Model.BookingCode" />
                            <button type="submit" class="btn btn-outline-secondary w-100 py-2 small fw-semibold">
                                <i class="bi bi-arrow-left-circle me-1"></i> Hủy giao dịch (Hủy đặt)
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <a asp-action="Checkout" asp-route-slotId="@Model.SlotId" class="btn btn-link text-muted small text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang thông tin đặt vé
            </a>
        </div>
    </div>
</div>
