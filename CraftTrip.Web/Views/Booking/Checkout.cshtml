@model CraftTrip.Web.ViewModels.BookingCheckoutViewModel
@{
    ViewData["Title"] = "Xác nhận đặt vé & Thanh toán";
    var ws = Model.Workshop;
    var slot = Model.Slot;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Workshop" asp-action="Details" asp-route-id="@ws.Id" class="text-decoration-none">@ws.Title</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thanh toán vé</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Left: Booking Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h4 class="font-serif fw-bold mb-4">Thông tin khách tham gia</h4>

                <form asp-action="ProcessPayment" method="post" id="checkoutForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SlotId" />

                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label small fw-semibold">Họ và tên người đại diện *</label>
                        <input asp-for="CustomerName" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerEmail" class="form-label small fw-semibold">Email nhận vé điện tử *</label>
                            <input asp-for="CustomerEmail" class="form-control" placeholder="email@domain.com" />
                            <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CustomerPhone" class="form-label small fw-semibold">Số điện thoại liên hệ *</label>
                            <input asp-for="CustomerPhone" class="form-control" placeholder="0912345678" />
                            <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Quantity" class="form-label small fw-semibold">Số lượng khách tham gia *</label>
                        <div class="d-flex align-items-center gap-3">
                            <input type="number" asp-for="Quantity" id="ticketQuantity" class="form-control" style="max-width: 120px;" min="1" max="@slot.AvailableCapacity" onchange="updateTotal()" oninput="updateTotal()" />
                            <span class="small text-muted">(Khung giờ này còn trống <strong>@slot.AvailableCapacity</strong> chỗ)</span>
                        </div>
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SpecialNotes" class="form-label small fw-semibold">Ghi chú đặc biệt cho nghệ nhân (nếu có)</label>
                        <textarea asp-for="SpecialNotes" class="form-control" rows="2" placeholder="Ví dụ: Có em nhỏ 6 tuổi đi cùng, cần hỗ trợ thêm đất sét..."></textarea>
                    </div>

                    <!-- Payment Method Selector -->
                    <h5 class="fw-bold mb-3 font-serif">Phương thức thanh toán</h5>
                    <div class="border rounded-3 p-3 bg-light mb-4">
                        <div class="form-check d-flex align-items-center gap-3">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="vnpayRadio" checked />
                            <label class="form-check-label d-flex align-items-center gap-2" for="vnpayRadio">
                                <span class="badge bg-primary px-2 py-1">VNPay</span>
                                <span class="fw-semibold">Cổng thanh toán VNPay (Hỗ trợ thẻ ATM nội địa, Visa/Master, quét mã VNPAY-QR)</span>
                            </label>
                        </div>
                    </div>

                    <!-- 48-Hour Cancellation Notice -->
                    <div class="alert alert-info border-0 rounded-3 p-3 small mb-4">
                        <i class="bi bi-shield-check text-primary me-1 fs-5"></i>
                        <strong>Chính sách hoàn hủy 100%:</strong> Bạn có thể hủy vé và nhận lại toàn bộ 100% số tiền nếu thao tác hủy được thực hiện trước ca trải nghiệm tối thiểu 48 tiếng.
                    </div>

                    <button type="submit" id="btnSubmitPayment" class="btn btn-primary w-100 py-3 fw-bold fs-6 shadow-sm">
                        <i class="bi bi-credit-card me-1"></i> Tiếp tục thanh toán VNPay
                    </button>
                </form>
            </div>
        </div>

        <!-- Right: Workshop Summary Box -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top bg-white" style="top: 80px;">
                <h5 class="font-serif fw-bold mb-3">Tóm tắt đơn đặt vé</h5>

                <div class="d-flex gap-3 mb-3 pb-3 border-bottom">
                    <img src="@ws.CoverImageUrl" alt="@ws.Title" class="rounded-3 object-fit-cover shadow-sm flex-shrink-0" style="width: 90px; height: 90px;" />
                    <div>
                        <span class="badge bg-light text-muted small">@ws.Category?.Name</span>
                        <h6 class="fw-bold mb-1 mt-1">@ws.Title</h6>
                        <small class="text-muted"><i class="bi bi-geo-alt me-1"></i> @ws.LocationAddress</small>
                    </div>
                </div>

                <div class="small text-muted mb-3 d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between">
                        <span>Ngày trải nghiệm:</span>
                        <strong class="text-dark">@slot.Schedule?.Date.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Khung giờ ca:</span>
                        <strong class="text-dark">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Đơn giá vé:</span>
                        <strong class="text-dark" id="unitPriceDisplay">@ws.BasePrice.ToString("N0") đ</strong>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-baseline mb-2">
                    <span class="fw-bold fs-6 text-dark">Tổng thành tiền:</span>
                    <span class="price-tag fs-3" id="totalPriceDisplay">@Model.EstimatedTotal.ToString("N0") đ</span>
                </div>
                <small class="text-muted fst-italic">Đã bao gồm toàn bộ nguyên vật liệu và hướng dẫn của nghệ nhân.</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const unitPrice = @ws.BasePrice;
        function updateTotal() {
            const qtyInput = document.getElementById('ticketQuantity');
            let qty = parseInt(qtyInput.value) || 1;
            if (qty < 1) qty = 1;
            const total = qty * unitPrice;
            document.getElementById('totalPriceDisplay').innerText = total.toLocaleString('vi-VN') + ' đ';
        }

        document.getElementById('checkoutForm')?.addEventListener('submit', function (e) {
            if (window.jQuery && !$(this).valid()) {
                return; // Let jQuery validate show error messages without disabling button
            }
            const btn = document.getElementById('btnSubmitPayment');
            if (btn) {
                setTimeout(function () {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang kết nối cổng thanh toán...';
                }, 0);
            }
        });
    </script>
}
