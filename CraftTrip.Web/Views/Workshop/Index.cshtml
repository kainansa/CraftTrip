@model CraftTrip.Web.ViewModels.WorkshopListViewModel
@{
    ViewData["Title"] = "Khám phá Workshop Thủ công";
}

<div class="container py-4">
    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Khám phá Workshop</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="font-serif fs-2 mb-1">Trải nghiệm Workshop Làng nghề</h1>
            <p class="text-muted small mb-0">Tìm thấy @Model.TotalCount trải nghiệm thủ công đang mở nhận khách</p>
        </div>

        <form method="get" class="d-flex align-items-center gap-2 mt-3 mt-md-0">
            <input type="hidden" name="keyword" value="@Model.Keyword" />
            <input type="hidden" name="categoryId" value="@Model.CategoryId" />
            <input type="hidden" name="villageId" value="@Model.VillageId" />
            <input type="hidden" name="minPrice" value="@Model.MinPrice" />
            <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
            <input type="hidden" name="maxDuration" value="@Model.MaxDuration" />

            <label class="small text-muted text-nowrap fw-semibold">Sắp xếp:</label>
            <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">Nổi bật nhất</option>
                <option value="newest" selected="@(Model.SortBy == "newest")">Mới nhất</option>
                <option value="rating" selected="@(Model.SortBy == "rating")">Đánh giá cao nhất</option>
                <option value="price-asc" selected="@(Model.SortBy == "price-asc")">Giá tăng dần</option>
                <option value="price-desc" selected="@(Model.SortBy == "price-desc")">Giá giảm dần</option>
            </select>
        </form>
    </div>

    <div class="row g-4">
        <!-- Sidebar Filters -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 80px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 fs-6"><i class="bi bi-funnel me-1 text-terracotta"></i> Bộ lọc tìm kiếm</h5>
                    <a asp-action="Index" class="small text-decoration-none text-muted">Đặt lại</a>
                </div>

                <form method="get" asp-action="Index">
                    <input type="hidden" name="sortBy" value="@Model.SortBy" />

                    <!-- Keyword -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Từ khóa</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="keyword" value="@Model.Keyword" class="form-control border-start-0 bg-light" placeholder="Tìm tên workshop..." />
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Ngành thủ công</label>
                        <select name="categoryId" class="form-select form-select-sm bg-light">
                            <option value="">Tất cả ngành nghề</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Village -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Làng nghề</label>
                        <select name="villageId" class="form-select form-select-sm bg-light">
                            <option value="">Tất cả làng nghề</option>
                            @foreach (var v in Model.Villages)
                            {
                                <option value="@v.Id" selected="@(Model.VillageId == v.Id)">@v.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Date -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Ngày trải nghiệm</label>
                        <input type="date" name="availableDate" value="@(Model.AvailableDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm bg-light" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- Price Range -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Mức giá tối đa</label>
                        <select name="maxPrice" class="form-select form-select-sm bg-light">
                            <option value="">Bất kỳ giá nào</option>
                            <option value="300000" selected="@(Model.MaxPrice == 300000)">Dưới 300.000 đ</option>
                            <option value="500000" selected="@(Model.MaxPrice == 500000)">Dưới 500.000 đ</option>
                            <option value="1000000" selected="@(Model.MaxPrice == 1000000)">Dưới 1.000.000 đ</option>
                        </select>
                    </div>

                    <!-- Duration -->
                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-muted">Thời lượng tối đa</label>
                        <select name="maxDuration" class="form-select form-select-sm bg-light">
                            <option value="">Bất kỳ thời lượng nào</option>
                            <option value="120" selected="@(Model.MaxDuration == 120)">Dưới 2 tiếng (120 phút)</option>
                            <option value="180" selected="@(Model.MaxDuration == 180)">Dưới 3 tiếng (180 phút)</option>
                            <option value="240" selected="@(Model.MaxDuration == 240)">Dưới 4 tiếng (240 phút)</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                        Áp dụng bộ lọc
                    </button>
                </form>
            </div>
        </div>

        <!-- Workshops Grid -->
        <div class="col-lg-9">
            @if (!Model.Workshops.Any())
            {
                <div class="text-center py-5 bg-white rounded-4 border p-5">
                    <i class="bi bi-search fs-1 text-muted opacity-50 mb-3 d-block"></i>
                    <h5 class="fw-bold">Không tìm thấy workshop phù hợp</h5>
                    <p class="text-muted small">Hãy thử điều chỉnh lại bộ lọc giá, làng nghề hoặc từ khóa tìm kiếm nhé.</p>
                    <a asp-action="Index" class="btn btn-outline-primary btn-sm mt-2">Xem tất cả workshop</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var ws in Model.Workshops)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="craft-card">
                                <div class="position-relative overflow-hidden">
                                    <img src="@ws.CoverImageUrl" alt="@ws.Title" class="craft-card-img" />
                                    <span class="position-absolute top-0 start-0 m-3 craft-badge-category">
                                        @ws.Category?.Name
                                    </span>
                                    @if (ws.AverageRating > 0)
                                    {
                                        <span class="position-absolute top-0 end-0 m-3 badge bg-white text-dark shadow-sm px-2 py-1">
                                            <i class="bi bi-star-fill text-warning me-1"></i> @ws.AverageRating.ToString("F1")
                                        </span>
                                    }
                                </div>
                                <div class="p-3 d-flex flex-column flex-grow-1">
                                    <div class="small text-muted mb-1">
                                        <i class="bi bi-geo-alt me-1"></i> @(ws.Village?.Name ?? ws.LocationAddress)
                                    </div>
                                    <h6 class="fw-bold mb-2">
                                        <a asp-action="Details" asp-route-id="@ws.Id" class="text-decoration-none text-dark">
                                            @ws.Title
                                        </a>
                                    </h6>
                                    <p class="text-muted small mb-3 flex-grow-1 line-clamp-2">@ws.ShortDescription</p>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                        <div>
                                            <span class="price-tag fs-6">@ws.BasePrice.ToString("N0") đ</span>
                                            <span class="price-unit">/ người</span>
                                        </div>
                                        <div class="small text-muted">
                                            <i class="bi bi-clock me-1"></i> @ws.DurationMinutes p
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-5 d-flex justify-content-center">
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-villageId="@Model.VillageId"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-maxDuration="@Model.MaxDuration"
                                   asp-route-sortBy="@Model.SortBy">Trước</a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-keyword="@Model.Keyword"
                                       asp-route-categoryId="@Model.CategoryId"
                                       asp-route-villageId="@Model.VillageId"
                                       asp-route-minPrice="@Model.MinPrice"
                                       asp-route-maxPrice="@Model.MaxPrice"
                                       asp-route-maxDuration="@Model.MaxDuration"
                                       asp-route-sortBy="@Model.SortBy">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-villageId="@Model.VillageId"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-maxDuration="@Model.MaxDuration"
                                   asp-route-sortBy="@Model.SortBy">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
