@model CraftTrip.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký thành viên";
}

<div class="container py-5">
    <div class="max-w-500 mx-auto">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <i class="bi bi-flower1 fs-1 text-warning mb-2 d-inline-block"></i>
                <h3 class="font-serif fw-bold mb-1">Đăng ký tài khoản CraftTrip</h3>
                <p class="text-muted small">Khám phá và đặt chỗ workshop cùng hàng trăm nghệ nhân</p>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small py-2 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label small fw-semibold">Họ và tên *</label>
                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Địa chỉ Email *</label>
                    <input asp-for="Email" class="form-control" placeholder="email@domain.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label small fw-semibold">Số điện thoại *</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="0912345678" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold">Mật khẩu *</label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Xác nhận mật khẩu *</label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 fw-bold fs-6 mb-3">
                    Tạo tài khoản ngay
                </button>
            </form>

            <div class="text-center small text-muted">
                Đã có tài khoản? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-terracotta fw-bold text-decoration-none">Đăng nhập tại đây</a>
            </div>
        </div>
    </div>
</div>
