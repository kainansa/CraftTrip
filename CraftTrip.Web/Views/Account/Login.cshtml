@model CraftTrip.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container py-5">
    <div class="max-w-500 mx-auto">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <i class="bi bi-flower1 fs-1 text-warning mb-2 d-inline-block"></i>
                <h3 class="font-serif fw-bold mb-1">Đăng nhập CraftTrip</h3>
                <p class="text-muted small">Chào mừng bạn quay trở lại với không gian làng nghề</p>
            </div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small py-2 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Địa chỉ Email</label>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold">Mật khẩu</label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4 small">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMeCheck" />
                        <label class="form-check-label text-muted" for="rememberMeCheck">Ghi nhớ đăng nhập</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 fw-bold fs-6 mb-3">
                    Đăng nhập ngay
                </button>
            </form>

            <div class="p-3 bg-light rounded-3 small text-muted mb-3">
                <div class="fw-bold text-dark mb-1">Tài khoản demo có sẵn:</div>
                <div>Admin: <code>admin@crafttrip.vn</code> / <code>CraftTrip@2026!</code></div>
                <div>Host: <code>host.battrang@crafttrip.vn</code> / <code>CraftTrip@2026!</code></div>
                <div>Guest: <code>guest@crafttrip.vn</code> / <code>CraftTrip@2026!</code></div>
            </div>

            <div class="text-center small text-muted">
                Chưa có tài khoản? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-terracotta fw-bold text-decoration-none">Đăng ký thành viên mới</a>
            </div>
        </div>
    </div>
</div>
