<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — CraftTrip" : "CraftTrip — Nền tảng Trải nghiệm Làng nghề & Workshop Việt Nam")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-craft py-2">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-flower1 text-warning fs-3"></i>
                    <span>CraftTrip</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Workshop" asp-action="Index">Khám phá Workshop</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Village" asp-action="Index">Làng nghề</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Trip" asp-action="Index">Chuyến đi gợi ý</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">Về CraftTrip</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-dark me-2">
                                    <i class="bi bi-shield-lock me-1"></i> Quản trị Admin
                                </a>
                            }
                            @if (User.IsInRole("Host"))
                            {
                                <a asp-area="Host" asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-outline-primary me-2">
                                    <i class="bi bi-shop me-1"></i> Quản lý Xưởng
                                </a>
                            }
                            else if (!User.IsInRole("Admin"))
                            {
                                <a asp-area="Host" asp-controller="Onboarding" asp-action="Index" class="btn btn-sm btn-outline-primary me-2">
                                    <i class="bi bi-plus-circle me-1"></i> Trở thành Host
                                </a>
                            }

                            <div class="dropdown">
                                <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border rounded-pill px-3 py-1 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 text-secondary"></i>
                                    <span class="small fw-semibold">@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="Booking" asp-action="Tickets"><i class="bi bi-qr-code text-primary me-2"></i> Vé của tôi</a></li>
                                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="Booking" asp-action="History"><i class="bi bi-clock-history me-2"></i> Đơn đặt chỗ</a></li>
                                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="Account" asp-action="Favorites"><i class="bi bi-heart me-2"></i> Yêu thích</a></li>
                                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i> Tài khoản của tôi</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-area="Host" asp-controller="Onboarding" asp-action="Index" class="btn btn-link text-decoration-none text-muted small fw-medium me-1">
                                Trở thành Host
                            </a>
                            <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm px-3">
                                Đăng nhập
                            </a>
                            <a asp-area="" asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm px-3">
                                Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="craft-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h5><i class="bi bi-flower1 me-2 text-warning"></i>CraftTrip</h5>
                    <p class="small text-muted pe-lg-4">
                        Nền tảng kết nối trực tiếp du khách với các nghệ nhân và làng nghề truyền thống Việt Nam. Cùng bảo tồn và lan tỏa nét đẹp văn hóa thủ công qua từng trải nghiệm chân thực.
                    </p>
                    <div class="d-flex gap-3 text-secondary fs-5">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-youtube"></i></a>
                        <a href="#"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5>Làng nghề</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-area="" asp-controller="Village" asp-action="Details" asp-route-slug="lang-gom-bat-trang">Gốm Bát Tràng</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Village" asp-action="Details" asp-route-slug="lang-lua-van-phuc">Lụa Vạn Phúc</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Village" asp-action="Details" asp-route-slug="lang-may-tre-dan-phu-vinh">Mây tre Phú Vinh</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Village" asp-action="Details" asp-route-slug="lang-son-mai-ha-thai">Sơn mài Hạ Thái</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Village" asp-action="Details" asp-route-slug="lang-tranh-dan-gian-dong-ho">Tranh Đông Hồ</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Dành cho khách</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-area="" asp-controller="Workshop" asp-action="Index">Tìm kiếm Workshop</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Trip" asp-action="Index">Lộ trình chuyến đi</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Faq">Câu hỏi thường gặp</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Terms">Chính sách hủy & hoàn tiền</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Dành cho Nghệ nhân</h5>
                    <p class="small text-muted">
                        Bạn có xưởng thủ công? Đăng ký mở bán trải nghiệm trực tiếp tới khách du lịch dễ dàng cùng đội ngũ hỗ trợ của chúng tôi.
                    </p>
                    <a asp-area="Host" asp-controller="Onboarding" asp-action="Index" class="btn btn-outline-warning btn-sm w-100 mb-2">
                        <i class="bi bi-shop me-1"></i> Mở xưởng trên CraftTrip
                    </a>
                </div>
            </div>
            <hr class="border-secondary opacity-25">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-muted">
                <div>© 2026 CraftTrip. Tinh hoa Làng nghề Việt. Mọi quyền được bảo lưu.</div>
                <div class="mt-2 mt-md-0">
                    <span class="me-3">Hotline: 1900 6868</span>
                    <span>Email: hotro@crafttrip.vn</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
