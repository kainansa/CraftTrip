@{
    ViewData["Title"] = "Về CraftTrip";
}

<div class="container py-5">
    <div class="max-w-800 mx-auto">
        <span class="text-terracotta fw-bold small text-uppercase tracking-wider">Sứ mệnh của chúng tôi</span>
        <h1 class="font-serif fs-1 fw-bold mb-4">CraftTrip — Nhịp cầu kết nối Di sản Làng nghề Việt</h1>

        <p class="lead text-secondary lh-lg mb-4">
            Việt Nam có hơn 5.400 làng nghề truyền thống trải dài khắp mọi miền đất nước, chứa đựng kho tàng tinh hoa văn hóa, lịch sử và tâm hồn của dân tộc. Tuy nhiên, trong kỷ nguyên số, nhiều làng nghề và nghệ nhân đang phải đối mặt với thách thức mai một và thiếu kênh tiếp cận trực tiếp đến du khách trong và ngoài nước.
        </p>

        <div class="rounded-4 overflow-hidden mb-5 shadow-sm">
            <img src="https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?auto=format&fit=crop&w=1200&q=80" alt="Làng nghề Việt Nam" class="w-100 object-fit-cover" style="max-height: 400px;" />
        </div>

        <h3 class="font-serif fw-bold mb-3">Tầm nhìn & Giá trị cốt lõi</h3>
        <p class="text-secondary lh-lg mb-4">
            CraftTrip không chỉ là nền tảng đặt chỗ trực tuyến đơn thuần. Chúng tôi xây dựng một hệ sinh thái trải nghiệm văn hóa số hóa, nơi nghệ nhân lớn tuổi ở nông thôn có thể dễ dàng quản lý xưởng trải nghiệm chỉ bằng vài thao tác trên điện thoại thông minh, không cần rào cản công nghệ.
        </p>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="p-3 bg-white rounded-3 border shadow-sm h-100">
                    <i class="bi bi-heart text-terracotta fs-3 mb-2 d-inline-block"></i>
                    <h6 class="fw-bold">Chân thực</h6>
                    <p class="small text-muted mb-0">100% trải nghiệm diễn ra tại xưởng thật, hướng dẫn bởi nghệ nhân thật.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-white rounded-3 border shadow-sm h-100">
                    <i class="bi bi-shield-check text-bamboo fs-3 mb-2 d-inline-block"></i>
                    <h6 class="fw-bold">Minh bạch</h6>
                    <p class="small text-muted mb-0">Chính sách hoa hồng rõ ràng, bảo vệ quyền lợi và đối soát thanh toán an toàn cho Host.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-white rounded-3 border shadow-sm h-100">
                    <i class="bi bi-flower1 text-warning fs-3 mb-2 d-inline-block"></i>
                    <h6 class="fw-bold">Bền vững</h6>
                    <p class="small text-muted mb-0">Góp phần tạo sinh kế trực tiếp cho nghệ nhân làng nghề địa phương.</p>
                </div>
            </div>
        </div>
    </div>
</div>
