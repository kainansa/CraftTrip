@{
    ViewData["Title"] = "Liên hệ";
}

<div class="container py-5">
    <div class="max-w-700 mx-auto">
        <h1 class="font-serif fs-1 fw-bold mb-3">Liên hệ với CraftTrip</h1>
        <p class="text-muted mb-5">Chúng tôi luôn sẵn sàng lắng nghe mọi góp ý và hỗ trợ bạn trong suốt hành trình khám phá di sản.</p>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="p-4 bg-white rounded-4 border text-center shadow-sm h-100">
                    <i class="bi bi-telephone text-wood fs-1 mb-2 d-inline-block"></i>
                    <h6 class="fw-bold">Tổng đài 24/7</h6>
                    <p class="text-muted small mb-0">1900 6868</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 bg-white rounded-4 border text-center shadow-sm h-100">
                    <i class="bi bi-envelope text-terracotta fs-1 mb-2 d-inline-block"></i>
                    <h6 class="fw-bold">Hộp thư hỗ trợ</h6>
                    <p class="text-muted small mb-0">hotro@crafttrip.vn</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 bg-white rounded-4 border text-center shadow-sm h-100">
                    <i class="bi bi-geo-alt text-bamboo fs-1 mb-2 d-inline-block"></i>
                    <h6 class="fw-bold">Văn phòng chính</h6>
                    <p class="text-muted small mb-0">Hà Nội, Việt Nam</p>
                </div>
            </div>
        </div>
    </div>
</div>
