@model CraftTrip.Web.ViewModels.HostWorkshopWizardViewModel
@using CraftTrip.Core.Enums
@{
    ViewData["Title"] = "Chỉnh sửa Workshop: " + Model.Title;
    var status = (WorkshopStatus?)ViewBag.WorkshopStatus ?? WorkshopStatus.Draft;
    bool hasPendingRevision = (bool)(ViewBag.HasPendingRevision ?? false);
}

<div class="host-container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2 rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
            <h1 class="h2 fw-bold text-dark mb-1">Chỉnh sửa trải nghiệm</h1>
            <p class="text-muted fs-6 mb-0">Cập nhật thông tin, hình ảnh và giá vé cho buổi trải nghiệm nghề của bác</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="fs-6 text-muted">Trạng thái:</span>
            @switch (status)
            {
                case WorkshopStatus.Draft:
                    <span class="badge bg-secondary px-3 py-2 fs-6 rounded-pill">Bản nháp</span>
                    break;
                case WorkshopStatus.Pending:
                    <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill">Đang chờ duyệt</span>
                    break;
                case WorkshopStatus.Published:
                    <span class="badge bg-success px-3 py-2 fs-6 rounded-pill">Đang mở bán</span>
                    break;
                case WorkshopStatus.Rejected:
                    <span class="badge bg-danger px-3 py-2 fs-6 rounded-pill">Cần bổ sung</span>
                    break;
            }
        </div>
    </div>

    @if (status == WorkshopStatus.Published)
    {
        <div class="alert alert-info border-2 shadow-sm d-flex align-items-start gap-3 p-4 mb-4 rounded-4" role="alert">
            <i class="bi bi-info-circle-fill fs-2 text-primary flex-shrink-0"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1">Trải nghiệm đang được mở bán trực tiếp</h5>
                <p class="mb-0 fs-6">
                    Để đảm bảo quyền lợi của khách du lịch, mọi thay đổi bạn lưu bên dưới sẽ được tạo thành <strong>Bản đề xuất cập nhật</strong> và gửi tới Ban quản trị duyệt.
                    Trong lúc chờ duyệt, trải nghiệm hiện tại vẫn hiển thị và đón khách bình thường với thông tin cũ.
                </p>
                @if (hasPendingRevision)
                {
                    <div class="mt-2 text-danger fw-semibold fs-6">
                        <i class="bi bi-clock-history me-1"></i> Bạn đang có 1 bản đề xuất đang chờ ban quản trị duyệt. Gửi bản mới sẽ thay thế bản đề xuất trước đó.
                    </div>
                }
            </div>
        </div>
    }

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card shadow-sm border-0 rounded-4 p-4 p-md-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

        <div class="row g-4">
            <!-- Cột 1: Thông tin cơ bản -->
            <div class="col-lg-8">
                <div class="p-4 bg-light rounded-4 mb-4 border">
                    <h4 class="fw-bold text-dark mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>1. Giới thiệu trải nghiệm</h4>
                    
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold fs-6">Tên trải nghiệm <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-lg fs-6" placeholder="Ví dụ: Tự tay vuốt gốm và vẽ men cùng nghệ nhân Bát Tràng" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold fs-6">Dòng nghề truyền thống <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select form-select-lg fs-6">
                                <option value="">-- Chọn ngành nghề --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="VillageId" class="form-label fw-semibold fs-6">Làng nghề của cơ sở <span class="text-danger">*</span></label>
                            <select asp-for="VillageId" asp-items="ViewBag.Villages" class="form-select form-select-lg fs-6">
                                <option value="">-- Chọn làng nghề --</option>
                            </select>
                            <span asp-validation-for="VillageId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LocationAddress" class="form-label fw-semibold fs-6">Địa chỉ xưởng đón khách <span class="text-danger">*</span></label>
                        <input asp-for="LocationAddress" class="form-control form-control-lg fs-6" placeholder="Ví dụ: Xưởng gốm nghệ nhân, Xóm 3, làng Bát Tràng, Gia Lâm, Hà Nội" />
                        <span asp-validation-for="LocationAddress" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ShortDescription" class="form-label fw-semibold fs-6">Tóm tắt ngắn (2 - 3 câu lôi cuốn) <span class="text-danger">*</span></label>
                        <textarea asp-for="ShortDescription" class="form-control fs-6" rows="3" placeholder="Mô tả ngắn gọn trải nghiệm để khách đọc khi lướt xem..."></textarea>
                        <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullDescription" class="form-label fw-semibold fs-6">Giới thiệu chi tiết trải nghiệm <span class="text-danger">*</span></label>
                        <textarea asp-for="FullDescription" class="form-control fs-6" rows="6" placeholder="Kể cho khách nghe về lịch sử nghề, không gian xưởng và cảm xúc khi làm đồ thủ công..."></textarea>
                        <span asp-validation-for="FullDescription" class="text-danger small"></span>
                    </div>
                </div>

                <div class="p-4 bg-light rounded-4 mb-4 border">
                    <h4 class="fw-bold text-dark mb-3"><i class="bi bi-list-check text-primary me-2"></i>2. Các bước và quà mang về</h4>
                    <div class="mb-3">
                        <label asp-for="ExperienceSteps" class="form-label fw-semibold fs-6">Các bước thực hành chính</label>
                        <textarea asp-for="ExperienceSteps" class="form-control fs-6" rows="4" placeholder="Bước 1: Nghe nghệ nhân giảng giải&#10;Bước 2: Chuốt đất trên bàn xoay&#10;Bước 3: Vẽ hoa văn..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TakeHomeProduct" class="form-label fw-semibold fs-6">Sản phẩm khách được mang về</label>
                        <input asp-for="TakeHomeProduct" class="form-control form-control-lg fs-6" placeholder="Ví dụ: 01 chiếc cốc gốm nung men bóng do chính tay du khách tạo tác" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="TargetAudience" class="form-label fw-semibold fs-6">Phù hợp với đối tượng nào?</label>
                        <input asp-for="TargetAudience" class="form-control form-control-lg fs-6" placeholder="Ví dụ: Gia đình có trẻ nhỏ, nhóm bạn trẻ, khách quốc tế" />
                    </div>
                </div>
            </div>

            <!-- Cột 2: Hình ảnh & Giá cả, Sức chứa -->
            <div class="col-lg-4">
                <!-- Ảnh bìa -->
                <div class="p-4 bg-light rounded-4 mb-4 border text-center">
                    <h4 class="fw-bold text-dark mb-3 text-start"><i class="bi bi-image text-primary me-2"></i>Ảnh đại diện</h4>
                    <div class="mb-3">
                        <img id="coverPreview" src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? "https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?auto=format&fit=crop&w=1000&q=80" : Model.CoverImageUrl)" 
                             class="img-fluid rounded-3 border shadow-sm w-100" style="max-height: 220px; object-fit: cover;" alt="Ảnh trải nghiệm" />
                    </div>
                    <input type="hidden" asp-for="CoverImageUrl" id="coverImageUrlInput" />
                    <label class="btn btn-outline-primary btn-lg w-100 py-2 fs-6 rounded-3 cursor-pointer">
                        <i class="bi bi-camera me-1"></i> Bấm để đổi ảnh mới
                        <input type="file" id="coverImageUploader" accept="image/*" class="d-none" onchange="uploadPhoto(this)" />
                    </label>
                    <small class="text-muted d-block mt-2">Chọn ảnh chụp xưởng, sản phẩm hoặc bác đang hướng dẫn khách</small>
                </div>

                <!-- Giá & Thời lượng -->
                <div class="p-4 bg-light rounded-4 mb-4 border">
                    <h4 class="fw-bold text-dark mb-3"><i class="bi bi-cash-stack text-primary me-2"></i>Giá vé & Sức chứa</h4>
                    
                    <div class="mb-3">
                        <label asp-for="BasePrice" class="form-label fw-semibold fs-6">Giá vé mỗi khách (VNĐ) <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg">
                            <input asp-for="BasePrice" type="number" step="10000" class="form-control fs-5 fw-bold text-primary" />
                            <span class="input-group-text">đ / người</span>
                        </div>
                        <span asp-validation-for="BasePrice" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DurationMinutes" class="form-label fw-semibold fs-6">Thời lượng (Phút) <span class="text-danger">*</span></label>
                        <select asp-for="DurationMinutes" class="form-select form-select-lg fs-6">
                            <option value="60">60 phút (1 tiếng)</option>
                            <option value="90">90 phút (1 tiếng rưỡi)</option>
                            <option value="120">120 phút (2 tiếng)</option>
                            <option value="180">180 phút (3 tiếng)</option>
                            <option value="240">240 phút (nửa ngày)</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="MinParticipants" class="form-label fw-semibold fs-6">Tối thiểu</label>
                            <input asp-for="MinParticipants" type="number" min="1" class="form-control form-control-lg fs-6" />
                        </div>
                        <div class="col-6">
                            <label asp-for="MaxParticipants" class="form-label fw-semibold fs-6">Tối đa</label>
                            <input asp-for="MaxParticipants" type="number" min="1" class="form-control form-control-lg fs-6" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IncludedServices" class="form-label fw-semibold fs-6">Đã bao gồm trong giá</label>
                        <input asp-for="IncludedServices" class="form-control fs-6" placeholder="Trà nước, nguyên vật liệu..." />
                    </div>

                    <div class="mb-0">
                        <label asp-for="PreparationGuide" class="form-label fw-semibold fs-6">Khách cần chuẩn bị gì</label>
                        <input asp-for="PreparationGuide" class="form-control fs-6" placeholder="Quần áo thoải mái, nón mũ..." />
                    </div>
                </div>

                <!-- Nút bấm hành động to rõ -->
                <div class="d-grid gap-3">
                    <button type="submit" class="btn btn-primary btn-lg py-3 fs-5 fw-bold rounded-4 shadow">
                        <i class="bi bi-check-circle-fill me-2"></i> Lưu cập nhật
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg py-3 fs-6 rounded-4">
                        Hủy bỏ và quay lại
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        async function uploadPhoto(input) {
            if (!input.files || !input.files[0]) return;
            const file = input.files[0];
            const formData = new FormData();
            formData.append('file', file);

            const preview = document.getElementById('coverPreview');
            preview.style.opacity = '0.5';

            try {
                const response = await fetch('@Url.Action("UploadImage", "Workshop", new { area = "Host" })', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                if (result.url) {
                    preview.src = result.url;
                    preview.style.opacity = '1';
                    document.getElementById('coverImageUrlInput').value = result.url;
                } else {
                    alert('Lỗi tải ảnh: ' + (result.error || 'Vui lòng thử lại'));
                    preview.style.opacity = '1';
                }
            } catch (err) {
                alert('Không thể tải ảnh lên. Vui lòng kiểm tra lại kết nối mạng.');
                preview.style.opacity = '1';
            }
        }
    </script>
}
