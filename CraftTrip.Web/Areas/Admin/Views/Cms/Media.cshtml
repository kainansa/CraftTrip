@model List<CraftTrip.Core.Entities.MediaAsset>
@{
    ViewData["Title"] = "Thư viện Hình ảnh Nền tảng";
}

<div class="admin-container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 mb-2">
                <i class="bi bi-arrow-left me-1"></i> Quay lại CMS
            </a>
            <h1 class="h2 fw-bold text-dark mb-0">Thư viện Hình ảnh Nền tảng</h1>
            <p class="text-muted fs-6 mb-0">Quản lý và sao chép đường dẫn hình ảnh đã tải lên hệ thống</p>
        </div>
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-images fs-1 mb-2 d-block"></i>
                Chưa có ảnh nào được tải lên thư viện.
            </div>
        }
        else
        {
            @foreach (var m in Model)
            {
                <div class="col-sm-6 col-md-4 col-xl-3">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                        <img src="@m.Url" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@m.FileName" />
                        <div class="card-body p-3">
                            <div class="fw-semibold text-truncate small" title="@m.FileName">@m.FileName</div>
                            <small class="text-muted d-block font-monospace">@((m.FileSize / 1024.0).ToString("N1")) KB</small>
                            <div class="input-group input-group-sm mt-2">
                                <input type="text" class="form-control font-monospace" value="@m.Url" readonly id="url_@m.Id" />
                                <button class="btn btn-outline-primary" type="button" onclick="navigator.clipboard.writeText('@m.Url'); alert('Đã sao chép link ảnh!');">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
