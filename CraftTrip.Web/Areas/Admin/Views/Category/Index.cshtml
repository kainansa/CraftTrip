@model List<CraftTrip.Core.Entities.CraftCategory>
@{
    ViewData["Title"] = "Quản lý Danh mục Nghề thủ công";
}

<div class="admin-container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">Danh mục Ngành nghề Thủ công</h1>
            <p class="text-muted fs-6 mb-0">Quản lý các loại hình nghề truyền thống (Gốm, Lụa, Mây tre đan, Tranh dân gian...)</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-circle me-2"></i> Thêm ngành nghề mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 fs-6">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Biểu tượng</th>
                        <th>Tên ngành nghề</th>
                        <th>Mô tả</th>
                        <th>Số Workshop</th>
                        <th class="text-center">Thứ tự</th>
                        <th class="text-center">Nổi bật</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="bg-light p-2 rounded-3 text-center d-inline-block" style="width: 45px; height: 45px;">
                                    <i class="bi @c.IconClass fs-4 text-primary"></i>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@c.Name</div>
                                <small class="text-muted font-monospace">@c.Slug</small>
                            </td>
                            <td>
                                <div class="text-muted text-truncate" style="max-width: 350px;">@c.Description</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@c.Workshops.Count workshop</span>
                            </td>
                            <td class="text-center font-monospace">@c.DisplayOrder</td>
                            <td class="text-center">
                                @if (c.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1 rounded-pill"><i class="bi bi-star-fill"></i> Nổi bật</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Thường</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    <i class="bi bi-pencil me-1"></i> Sửa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
