<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — Quản Trị Hệ Thống CraftTrip" : "CraftTrip Administration")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light">
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Admin Sidebar -->
            <div class="col-lg-2 col-md-3 admin-sidebar p-3 d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-4 px-2">
                    <i class="bi bi-shield-shaded fs-3 text-warning"></i>
                    <div>
                        <div class="fw-bold fs-5 text-white">CraftTrip Admin</div>
                        <small class="text-white-50">Trung tâm điều hành</small>
                    </div>
                </div>

                <div class="nav flex-column mb-auto">
                    <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Tổng quan
                    </a>
                    <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Approval" ? "active" : "")" asp-area="Admin" asp-controller="Approval" asp-action="Index">
                        <i class="bi bi-check-circle"></i> Duyệt Workshop
                    </a>
                    <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Workshop" ? "active" : "")" asp-area="Admin" asp-controller="Workshop" asp-action="Index">
                        <i class="bi bi-palette"></i> Tất cả Workshop
                    </a>
                    <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Village" ? "active" : "")" asp-area="Admin" asp-controller="Village" asp-action="Index">
                        <i class="bi bi-pin-map"></i> Quản lý Làng nghề
                    </a>
                    <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")" asp-area="Admin" asp-controller="Category" asp-action="Index">
                        <i class="bi bi-tags"></i> Danh mục thủ công
                    </a>
                    <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Trip" ? "active" : "")" asp-area="Admin" asp-controller="Trip" asp-action="Index">
                        <i class="bi bi-signpost-split"></i> Lộ trình Chuyến đi
                    </a>
                    <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cms" ? "active" : "")" asp-area="Admin" asp-controller="Cms" asp-action="Index">
                        <i class="bi bi-window-sidebar"></i> Quản lý CMS Website
                    </a>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="Cms" asp-action="Media">
                        <i class="bi bi-images"></i> Thư viện hình ảnh
                    </a>
                    <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Financial" ? "active" : "")" asp-area="Admin" asp-controller="Financial" asp-action="Index">
                        <i class="bi bi-cash-coin"></i> Tài chính & Hoa hồng
                    </a>
                    <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")" asp-area="Admin" asp-controller="User" asp-action="Index">
                        <i class="bi bi-people"></i> Quản lý Người dùng
                    </a>
                    <a class="admin-nav-link" asp-area="Admin" asp-controller="User" asp-action="Hosts">
                        <i class="bi bi-patch-check"></i> Xác thực Đối tác Host
                    </a>
                </div>

                <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 px-2">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm w-100 mb-2">
                        <i class="bi bi-eye me-1"></i> Xem trang chủ
                    </a>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm w-100">
                            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                        </button>
                    </form>
                </div>
            </div>

            <!-- Admin Main Content Area -->
            <div class="col-lg-10 col-md-9 min-vh-100 d-flex flex-column">
                <nav class="navbar navbar-expand bg-white border-bottom px-4 py-2 sticky-top">
                    <div class="ms-auto d-flex align-items-center gap-3">
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                            <i class="bi bi-shield-lock-fill me-1"></i> Administrator Role
                        </span>
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle rounded-pill py-1 px-3 border shadow-sm small fw-semibold" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-fill me-1"></i> @User.Identity?.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger py-2">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>

                <div class="p-4 flex-grow-1">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                            <div>@TempData["ErrorMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </div>

                <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
                    CraftTrip Marketplace Admin Console © 2026. Phiên bản hệ thống 1.1 (Production Ready).
                </footer>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
