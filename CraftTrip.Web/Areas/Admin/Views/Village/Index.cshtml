@model List<CraftTrip.Core.Entities.Village>
@{
    ViewData["Title"] = "Quản lý Làng nghề truyền thống";
}

<div class="admin-container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">Quản lý Làng nghề Truyền thống</h1>
            <p class="text-muted fs-6 mb-0">Quản lý cơ sở dữ liệu các làng nghề di sản văn hóa trên khắp Việt Nam</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-circle me-2"></i> Thêm làng nghề mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 fs-6">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Hình ảnh</th>
                        <th>Tên Làng nghề</th>
                        <th>Tỉnh / Thành</th>
                        <th>Số Workshop</th>
                        <th class="text-center">Thứ tự</th>
                        <th class="text-center">Nổi bật</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <img src="@v.CoverImageUrl" class="rounded-3 shadow-xs" style="width: 70px; height: 50px; object-fit: cover;" alt="@v.Name" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@v.Name</div>
                                <small class="text-muted">Slug: @v.Slug</small>
                            </td>
                            <td>@v.Location</td>
                            <td>
                                <span class="badge bg-light text-dark border">@v.Workshops.Count workshop</span>
                            </td>
                            <td class="text-center font-monospace">@v.DisplayOrder</td>
                            <td class="text-center">
                                @if (v.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1 rounded-pill"><i class="bi bi-star-fill"></i> Nổi bật</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Thường</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        <i class="bi bi-pencil me-1"></i> Sửa
                                    </a>
                                    <a asp-area="" asp-controller="Village" asp-action="Details" asp-route-id="@v.Id" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                        Xem
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
